# Safe placeholders only. Demo works without credentials or network.
PM_DATABASE=data/projects.sqlite3
PM_ALLOW_PAID_CALLS=false
PM_FREE_ONLY=true
# Set true only after confirming the corresponding account/project has paid billing disabled.
PM_GROQ_FREE_TIER_CONFIRMED=false
PM_GEMINI_FREE_TIER_CONFIRMED=false
PM_REQUIREMENTS_PROVIDER=gemini
PM_PLANNING_PROVIDER=groq
PM_REVIEW_PROVIDER=openrouter
# Optional explicit free-provider fallback; no automatic fallback is enabled by default.
PM_REQUIREMENTS_FALLBACK_PROVIDER=none
PM_PLANNING_FALLBACK_PROVIDER=none
PM_REVIEW_FALLBACK_PROVIDER=none
OPENAI_API_KEY=replace-with-your-server-side-key
# Existing adapter is blocked by PM_FREE_ONLY=true. No paid default selected.
OPENAI_MODEL=

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Google Gemini
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (OpenAI-compatible API)
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Repair inherits the planning fallback unless explicitly overridden. Uncomment to opt out.
# PM_REPAIR_FALLBACK_PROVIDER=none
